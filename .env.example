# Mining Marketplace Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# x402 PAYMENT CONFIGURATION (REQUIRED)
# ============================================

# Base USDC receive address (0x4acked... format)
# This is where x402 payments will be sent
X402_PAY_TO=0x0000000000000000000000000000000000000000

# ============================================
# PRICING CONFIGURATION
# ============================================

# Price for starting a mining session (USDC)
# Default: 25.50
X402_PRICE_SESSION_START=25.50

# Price for querying mining stats (USDC)
# Default: 1.00
X402_PRICE_STATS=1.00

# ============================================
# SERVER CONFIGURATION
# ============================================

# Server port (default: 3000)
PORT=3000

# ============================================
# OPTIONAL: FACILITATOR SETTINGS
# ============================================

# Optional: Override x402 facilitator URL
# Default: https://x402-agent-pay.com/facilitator
# X402_FACILITATOR=https://x402-agent-pay.com/facilitator

# ============================================
# NETWORK CONFIGURATION
# ============================================

# Ethereum network for x402 payments
# Default: eip155:8453 (Base mainnet)
# NETWORK=eip155:8453