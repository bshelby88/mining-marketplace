{
  "name": "mining-marketplace",
  "version": "1.0.0",
  "description": "Decentralized cryptocurrency mining marketplace with x402 payment protocol integration",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --exec ts-node src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "verify:surfaces": "node -e \"const app = require('./dist/index.js').default || require('./dist/index.js'); console.log('Discovery surfaces verified')\""
  },
  "keywords": [
    "x402",
    "mining",
    "cryptocurrency",
    "micropayments",
    "marketplace",
    "blockchain",
    "base",
    "ethereum"
  ],
  "author": "MINING GITHUB INFRA",
  "license": "MIT",
  "dependencies": {
    "@coinbase/x402": "^2.12.0",
    "axios": "^1.6.0",
    "dotenv": "^16.3.0",
    "express": "^4.18.2",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^2.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.2.0"
  }
}